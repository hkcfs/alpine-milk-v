#!/bin/sh
# milkv-usb-mode - switch Duo 256M USB operation mode.
# Usage: milkv-usb-mode [host|ncm|acm]
#   host  USB-A host mode (peripherals)
#   ncm   USB-C network gadget (SSH over usb0, default)
#   acm   USB-C serial gadget (login over /dev/ttyGS0)
# Persists via /etc/milkv-usb-mode; applied at boot by milkv-usb-init.
set -u
MODE="${1:-}"
CONF=/etc/milkv-usb-mode
GADGET=/sys/kernel/config/usb_gadget/milkv
UDC="$(ls /sys/class/udc 2>/dev/null | head -1)"

usb_off() {
    echo "" > "$GADGET/UDC" 2>/dev/null || true
}

gadget_up() {
    func="$1"
    mkdir -p "$GADGET" 2>/dev/null || return 0
    [ -e "$GADGET/idVendor" ] || {
        echo 0x3346 > "$GADGET/idVendor"; echo 0x1008 > "$GADGET/idProduct"
        mkdir -p "$GADGET/strings/0x409"
        echo "milkv" > "$GADGET/strings/0x409/manufacturer"
        echo "duo256m" > "$GADGET/strings/0x409/product"
        echo "0123456789" > "$GADGET/strings/0x409/serialnumber"
        mkdir -p "$GADGET/functions/$func.usb0" "$GADGET/configs/c.1/strings/0x409"
        ln -sf "$GADGET/functions/$func.usb0" "$GADGET/configs/c.1/" 2>/dev/null || true
        echo "milkv-usb" > "$GADGET/configs/c.1/strings/0x409/configuration"
    }
    [ -n "$UDC" ] && echo "$UDC" > "$GADGET/UDC"
}

case "$MODE" in
    host) usb_off; echo host > "$CONF"; echo "USB host mode (reboot to apply fully)" ;;
    ncm)  usb_off; gadget_up ncm; echo ncm > "$CONF"; echo "USB NCM gadget on usb0 (ssh root@192.168.42.1)" ;;
    acm)  usb_off; gadget_up acm; echo acm > "$CONF"; echo "USB ACM gadget on /dev/ttyGS0" ;;
    *)    echo "usage: $0 [host|ncm|acm]"; echo "current: $(cat "$CONF" 2>/dev/null || echo ncm)"; exit 1 ;;
esac
